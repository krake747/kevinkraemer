{
    "name": "kevinkraemer",
    "version": "0.0.1",
    "license": "MPL-2.0",
    "author": "Kevin Kraemer",
    "repository": {
        "type": "git",
        "url": "https://github.com/krake747/kevinkraemer.git"
    },
    "type": "module",
    "scripts": {
        "build": "pnpm generate && vp build && node scripts/prerender.ts && node scripts/function.ts && pagefind --site dist/client",
        "check:docs": "node scripts/checks/docs.mjs",
        "check:comments": "node scripts/checks/no-prose-comments.mjs",
        "check:agents": "node scripts/checks/agent-reachability.mjs",
        "check:prose": "vp fmt --check \"content/logs/**/*.md\" && node scripts/prose/cliche-lint.mjs",
        "dev": "pnpm generate && vp dev",
        "dev:search": "pnpm build && vp dev",
        "fmt": "vp fmt",
        "fmt:ci": "vp fmt --check",
        "generate": "node scripts/content.ts && node --import ./scripts/alias-loader.mjs scripts/tape.ts && node --import ./scripts/alias-loader.mjs scripts/site-files.ts",
        "lint": "vp lint --deny-warnings",
        "lint:ts": "vpr generate && tsc --noEmit",
        "prepare": "if [ \"$CI\" = \"true\" ]; then echo \"CI detected: skipping lefthook install\"; else lefthook install; fi",
        "preview": "BROWSER=none npxnetlify serve --offline --filter kevinkraemer",
        "prerender": "node scripts/prerender.ts",
        "test": "vp test run",
        "test:e2e": "playwright test",
        "test:vitest": "vp test run --config vitest.config.ts",
        "test:coverage": "vp test run --coverage --config vitest.config.ts",
        "verify": "pnpm fmt:ci && pnpm lint && pnpm lint:ts && pnpm check:docs && pnpm exec fallow audit --quiet && pnpm test:vitest"
    },
    "dependencies": {
        "@modelcontextprotocol/server": "^2.4.0",
        "@solid-primitives/event-listener": "^3.0.0",
        "@solid-primitives/intersection-observer": "^3.0.0",
        "@solid-primitives/media": "^4.0.0",
        "@solid-primitives/scheduled": "^2.0.0",
        "@solidjs/meta": "^2.0.0",
        "@solidjs/router": "^2.0.1",
        "@solidjs/web": "^2.0.3",
        "@typesafe-ai/sdk": "^0.7.0",
        "@ui-sdk/core": "0.1.0-beta.16",
        "@ui-sdk/solid": "0.1.0-beta.16",
        "@valibot/to-json-schema": "^1.8.0",
        "better-result": "^3.0.1",
        "cn": "0.5.2",
        "cva": "1.0.0-beta.12",
        "openai": "^7.62.0",
        "solid-js": "^2.0.3",
        "tailwindcss": "^4.3.5",
        "turndown": "^7.2.5",
        "turndown-plugin-gfm": "^1.0.2",
        "valibot": "^1.5.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@iconify-json/keyline-icons": "^1.2.25",
        "@lhci/cli": "0.16.1",
        "@playwright/test": "^1.65.1",
        "@shadcn/lint": "^0.2.5",
        "@solidjs/vite-plugin": "^3.0.1",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/jest-dom": "^8.0.0",
        "@types/node": "^26.6.6",
        "@types/turndown": "^5.0.6",
        "@vitest/browser-playwright": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "eslint-plugin-solid": "~0.20.1",
        "fallow": "^3.47.0",
        "filesystem-routing": "^0.5.0",
        "github-slugger": "^2.0.0",
        "happy-dom": "^21.0.4",
        "lefthook": "^2.2.2",
        "netlify": "^27.20.1",
        "pagefind": "^1.6.0",
        "playwright": "^1.65.1",
        "puppeteer-core": "^25.18.1",
        "satteri": "^0.11.7",
        "tsrs": "7.1.0-beta.tsrs4",
        "typescript": "^7.0.2",
        "unplugin-icons": "^24.0.0",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitest": "catalog:",
        "yaml": "^2.9.1"
    },
    "browserslist": {
        "production": [
            "> 0.5% in US or > 0.5% in alt-EU",
            "last 2 versions",
            "Firefox ESR",
            "not dead"
        ],
        "development": [
            "last 1 Chrome version",
            "last 1 ChromeAndroid version",
            "last 1 Edge version",
            "last 1 Firefox version",
            "last 1 FirefoxAndroid version",
            "last 1 Safari version",
            "last 1 iOS version"
        ]
    },
    "packageManager": "pnpm@12.23.0"
}
